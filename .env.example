# TradingAgents Framework - Environment Variables Configuration
# Copy this file to .env and fill in your API keys

# LLM Provider API Keys (Use one based on your selected provider)
# ================================================================

# Google AI API Key
# Get it from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=

# OpenRouter API Key (RECOMMENDED - Works with all providers)
# Get it from: https://openrouter.ai/keys
# OpenRouter provides access to Google Gemini, Llama, and other models
OPENROUTER_API_KEY=

# Groq API Key
# Get it from: https://console.groq.com/keys
GROQ_API_KEY=

# Data Provider API Keys (Optional)
# ================================================================

# Alpha Vantage API Key (Optional - for premium data quality)
# Free API: https://www.alphavantage.co/support/#api-key
# Default: Yahoo Finance (yfinance) - No API key required
# Use Alpha Vantage for: Higher quality data, detailed fundamentals, reliable news
# Free tier: 25 requests/day, 5 requests/minute
# TradingAgents-sourced requests have increased rate limits (60 req/min)
ALPHA_VANTAGE_API_KEY=

# Optional API Keys (NOT REQUIRED)
# ================================================================

# OpenAI API Key (NOT REQUIRED - OpenAI support removed)
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (NOT REQUIRED - Anthropic support removed)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# NOTES:
# ======
# - OpenRouter is RECOMMENDED as it provides access to multiple models
# - When using Google provider, you can use either GOOGLE_API_KEY or OPENROUTER_API_KEY
# - Groq provides the fastest inference speeds with Llama models
# - OpenAI and Anthropic are NOT supported in this version
